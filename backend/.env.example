# ── Chain ─────────────────────────────────────────────
NETWORK=localhost                    # reads ../deployments/<NETWORK>.json
RPC_URL=http://127.0.0.1:8545        # Sepolia: https://eth-sepolia.g.alchemy.com/v2/<key>
CONFIRMATIONS=0                      # blocks to wait before an event is "confirmed" (use 3+ on Sepolia)
POLL_INTERVAL_MS=2000
BLOCK_CHUNK=2000                     # max blocks per getLogs call (public RPCs limit this)
# START_BLOCK=0                      # optional override of the deployment's startBlock
EXPLORER_URL=                        # e.g. https://sepolia.etherscan.io (adds links to receipts)

# ── API ───────────────────────────────────────────────
PORT=4001

# ── Webhooks (optional) ───────────────────────────────
WEBHOOK_URL=http://127.0.0.1:4000/webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_MAX_ATTEMPTS=6
